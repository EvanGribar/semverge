{
  "name": "semverge",
  "version": "0.14.0",
  "description": "Release-readiness automation for Node.js and GitHub: versioning, customer communication, artifacts, npm publishing, and post-release verification.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EvanGribar/semverge.git"
  },
  "bin": {
    "semverge": "lib/cli.js"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "dist",
    "action.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/action.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.cjs --sourcemap --sources-content=false",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm bundle"
  },
  "dependencies": {
    "semver": "^7.8.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
