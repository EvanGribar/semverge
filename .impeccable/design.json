  "narrative": {
    "northStar": "Operational instruments and change records",
    "overview": "The platform is calm, exact and accountable. Near-black graphite fields, silver lettering and off-white actions support a dense but readable operating workspace. The direct user-supplied Sero board leads the identity; its monochrome direction supersedes the earlier blue reference. Original convergence ribbons interpret directional light without copying the reference's logo.\n\nThis document captures the implemented `platform/web` world, including sign-in, Overview, Releases, Monitoring and Incidents. The separate website/brand.html marketing identity page uses generated imagery and the existing mark; it does not redefine the operational workspace. The implementation was code-first and reviewed in rendered desktop and 393px mobile captures; there is no approved comp. Surface composition remains in `.impeccable/surface-brief.md`. The approved Unslop polish method is attributed to [Damir Sokolovsky (@heydamir)](https://github.com/heydamir/unslop), [CC BY 4.0](https://creativecommons.org/licenses/by/4.0/); its example assets are not distributed. semverge remains MIT licensed.",
    "keyCharacteristics": [
      "Monochrome graphite and silver identity",
      "Three neutral text roles with restrained semantic status color",
      "Persistent service, environment and release context",
      "Measured line icons and original vector convergence artwork",
      "Responsive records with directly visible operational state"
    ],
    "rules": [
      {
        "name": "The Status Has a Word Rule",
        "body": "Every operational state has a visible text label; hue and a small symbol reinforce it.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** preserve graphite surfaces, off-white actions and the three neutral text roles.",
      "**Do** pair every status hue with an explicit word and retain unknown and paused distinctions.",
      "**Do** keep service, environment and release context readable on mobile.",
      "**Do** use the authored line icons, original convergence artwork and short reduced-motion-aware feedback."
    ],
    "donts": [
      "**Don't** reintroduce blue as the platform brand accent; the user's direct monochrome reference supersedes it.",
      "**Don't** add decorative metrics, invented history or navigation for unimplemented product areas.",
      "**Don't** shrink metadata below the platform's 11px floor or hide service state in an offscreen ledger.",
      "**Don't** apply this platform specification to the separate optional website without a separate scope decision."
    ]
  }
}
